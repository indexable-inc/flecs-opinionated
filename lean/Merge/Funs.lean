      | Value.Counter _ => ok (core.result.Result.Err Error.Mismatch)
      | Value.Multi _ => ok (core.result.Result.Err Error.Mismatch)
    | Value.Set _ => ok (core.result.Result.Err Error.Mismatch)
    | Value.Counter _ => ok (core.result.Result.Err Error.Mismatch)
    | Value.Multi _ => ok (core.result.Result.Err Error.Mismatch)
  | Rule.AddWins =>
