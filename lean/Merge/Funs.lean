    Source: 'merge/src/lib.rs', lines 510:0-547:1
    Visibility: public -/
def validate (rule : Rule) (value : Value) : Result Bool := do
  match rule with
  | Rule.LastWriter =>
    match value with
    | Value.Register _ => ok true
    | Value.Set _ => ok false
    | Value.Counter _ => ok false
    | Value.Multi _ => ok false
  | Rule.AddWins =>
    match value with
    | Value.Register _ => ok false
    | Value.Set s =>
      let b ← tagged_sorted s.entries
      if b
      then stamps_sorted s.removed
      else ok false
    | Value.Counter _ => ok false
    | Value.Multi _ => ok false
  | Rule.Counter =>
    match value with
    | Value.Register _ => ok false
    | Value.Set _ => ok false
    | Value.Counter c =>
      let b ← counts_sorted c.inc
      if b
      then counts_sorted c.dec
      else ok false
    | Value.Multi _ => ok false
  | Rule.KeepBoth =>
    match value with
    | Value.Register _ => ok false
    | Value.Set _ => ok false
    | Value.Counter _ => ok false
    | Value.Multi s =>
      let b ← tagged_sorted s.entries
      if b
      then stamps_sorted s.removed
      else ok false

