def apply
  (rule : Rule) (state : Value) (op : Op) :
  Result (core.result.Result Value Error)
  := do
  match op with
  | Op.Write stamp value => merge rule state (Value.Register { stamp, value })
  | Op.Add tag element =>
    merge rule state (Value.Set
      { entries := (Tagged.Cons tag element Tagged.Nil), removed := Stamps.Nil
      })
  | Op.Remove seen =>
    let s ← stamps_copy seen
    merge rule state (Value.Set { entries := Tagged.Nil, removed := s })
  | Op.Inc actor n =>
    match rule with
    | Rule.LastWriter => ok (core.result.Result.Err Error.Mismatch)
    | Rule.AddWins => ok (core.result.Result.Err Error.Mismatch)
    | Rule.Counter =>
      match state with
      | Value.Register _ => ok (core.result.Result.Err Error.Mismatch)
      | Value.Set _ => ok (core.result.Result.Err Error.Mismatch)
      | Value.Counter pn =>
        let r ← counts_bump pn.inc actor n
        match r with
        | core.result.Result.Ok inc =>
          let c ← counts_copy pn.dec
          ok (core.result.Result.Ok (Value.Counter { inc, dec := c }))
        | core.result.Result.Err e => ok (core.result.Result.Err e)
      | Value.Multi _ => ok (core.result.Result.Err Error.Mismatch)
    | Rule.KeepBoth => ok (core.result.Result.Err Error.Mismatch)
  | Op.Dec actor n =>
    match rule with
    | Rule.LastWriter => ok (core.result.Result.Err Error.Mismatch)
    | Rule.AddWins => ok (core.result.Result.Err Error.Mismatch)
    | Rule.Counter =>
      match state with
      | Value.Register _ => ok (core.result.Result.Err Error.Mismatch)
      | Value.Set _ => ok (core.result.Result.Err Error.Mismatch)
      | Value.Counter pn =>
        let r ← counts_bump pn.dec actor n
        match r with
        | core.result.Result.Ok dec =>
          let c ← counts_copy pn.inc
          ok (core.result.Result.Ok (Value.Counter { inc := c, dec }))
        | core.result.Result.Err e => ok (core.result.Result.Err e)
      | Value.Multi _ => ok (core.result.Result.Err Error.Mismatch)
    | Rule.KeepBoth => ok (core.result.Result.Err Error.Mismatch)
  | Op.Put tag value seen =>
    let s ← stamps_copy seen
    merge rule state (Value.Multi
      { entries := (Tagged.Cons tag value Tagged.Nil), removed := s })

