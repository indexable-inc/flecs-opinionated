{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "esnext.disposable", "dom"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "js/src",
    "skipLibCheck": true
  },
  "include": ["js/src"]
}
